# Copy to .env.local and fill in. Never commit real values.

# Supabase project (local: run `npm run db:start` and copy the printed values)
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Shared tier passwords
BROTHER_PASSWORD=replace-with-brother-password
ADMIN_PASSWORD=replace-with-admin-password

# Signs session cookies. At least 32 random characters: openssl rand -base64 48
SESSION_SECRET=replace-with-at-least-32-random-characters
